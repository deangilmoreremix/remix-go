{
  "name": "remix-go-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "security-audit": "node scripts/security-audit.js",
    "load-test": "k6 run load-testing/load-test.js",
    "analyze-bundle": "npx vite-bundle-analyzer dist",
    "clean": "rm -rf dist coverage .vite"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "grapesjs": "^0.22.7",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.2",
    "grapesjs-preset-newsletter": "^1.0.1",
    "@silexlabs/grapesjs-ai-copilot": "^0.0.33",
    "sortablejs": "^1.15.7",
    "sweetalert2": "^11.0.0",
    "react-error-boundary": "^4.0.13",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.2",
    "@playwright/test": "^1.45.0",
    "typescript": "^5.4.5"
  }
}
