{
  "name": "higgsfield-monorepo",
  "version": "1.0.0",
  "description": "Higgsfield AI Platform - Main app and Remix Go Video Editor",
  "private": true,
  "workspaces": [
    ".",
    "apps/remix-go"
  ],
  "scripts": {
    "install:all": "npm install && cd apps/remix-go && npm install",
    "build": "npm run build:main && npm run build:remix-go",
    "build:main": "next build",
    "build:remix-go": "cd apps/remix-go && npm run build",
    "build:parallel": "concurrently \"npm run build:main\" \"npm run build:remix-go\"",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:remix-go\"",
    "dev:main": "node server.js",
    "dev:remix-go": "cd apps/remix-go && npm run dev",
    "test": "npm run test:main && npm run test:remix-go",
    "test:main": "npm test",
    "test:remix-go": "cd apps/remix-go && npm test",
    "test:integration": "npm run test:integration:build && npm run test:integration:run",
    "test:integration:build": "docker-compose -f docker-compose.test.yml build",
    "test:integration:run": "docker-compose -f docker-compose.test.yml up --abort-on-container-exit",
    "lint": "npm run lint:main && npm run lint:remix-go",
    "lint:main": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:remix-go": "cd apps/remix-go && eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint:main -- --fix && npm run lint:remix-go -- --fix",
    "type-check": "npm run type-check:main && npm run type-check:remix-go",
    "type-check:main": "tsc --noEmit",
    "type-check:remix-go": "cd apps/remix-go && tsc --noEmit",
    "clean": "rm -rf .next apps/remix-go/dist node_modules apps/remix-go/node_modules .cache",
    "clean:deps": "npm run clean && npm install",
    "analyze": "npm run analyze:main && npm run analyze:remix-go",
    "analyze:main": "ANALYZE=true npm run build:main",
    "analyze:remix-go": "cd apps/remix-go && ANALYZE=true npm run build",
    "deploy:staging": "npm run build && npm run deploy:staging:main && npm run deploy:staging:remix-go",
    "deploy:production": "npm run build && npm run deploy:prod:main && npm run deploy:prod:remix-go",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "docker:build": "docker build -t higgsfield .",
    "docker:run": "docker run -p 3000:3000 higgsfield",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "db:migrate": "npm run db:migrate:main",
    "db:migrate:main": "node scripts/migrate.js",
    "db:seed": "npm run db:seed:main",
    "db:seed:main": "node scripts/seed.js",
    "db:reset": "npm run db:reset:main",
    "db:reset:main": "node scripts/reset-db.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "concurrently": "^7.6.0",
    "wait-on": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "rimraf": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "eslint": "^8.37.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.7",
    "typescript": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deangilmoreremix/Open-Higgsfield-AI.git"
  },
  "keywords": [
    "video-editor",
    "ai",
    "remix",
    "higgsfield",
    "landing-pages",
    "personalization"
  ],
  "author": "Digital Strategies",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/deangilmoreremix/Open-Higgsfield-AI/issues"
  },
  "homepage": "https://github.com/deangilmoreremix/Open-Higgsfield-AI#readme"
}